<?xml version="1.0" encoding="utf-8"?>
<!-- Row layout for ListView demonstration -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="12dp"
        android:paddingBottom="12dp"
    android:paddingStart="8dp"
        android:paddingEnd="8dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvPortIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="#DBEAFE"
        android:gravity="center"
        android:text="⚓"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPortName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Port of Singapore (Jurong Deep Sea Channel)"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPortDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Max Draft: 16.5m · International Hub"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPortCoordinates"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1.29°N, 103.85°E"
        android:textColor="@color/brand_ocean_primary"
        android:textSize="11sp" />

</LinearLayout>
