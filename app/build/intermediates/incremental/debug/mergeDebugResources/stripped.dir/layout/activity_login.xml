<?xml version="1.0" encoding="utf-8"?>
<!-- 
    AquaSky Authentication Screen
    Features: Distinct Sign In & Register Tabs, Firebase Auth, Role Selection
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:id="@+id/loginRootLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tvLoginTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="AquaSky Identity"
            android:textColor="@color/brand_ocean_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Firebase Global Navigator Authentication"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <!-- Tab Selector: [ Sign In ] vs [ Register (New Account) ] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="24dp"
            android:background="#150284C7"
            android:orientation="horizontal"
            android:padding="3dp"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
        android:insetTop="0dp"
        android:insetBottom="0dp"
                android:id="@+id/btnTabSignIn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="@color/brand_ocean_primary"
                android:text="Sign In"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
        android:insetTop="0dp"
        android:insetBottom="0dp"
                android:id="@+id/btnTabRegister"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Register (New)"
                android:textAllCaps="false"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Form Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <!-- Full Name (Only visible when Register tab is selected) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFullName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                android:hint="Full Name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Email Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email Address"
                app:placeholderText="yourname@gmail.com">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Security Password (min 6 characters)"
                app:passwordToggleEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:text="AquaSkyGlobal2026!" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Role Selector (Visible during Registration) -->
            <LinearLayout
                android:id="@+id/layoutRoleSelectorContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SELECT NAVIGATOR ROLE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_ocean_primary" />

                <RadioGroup
                    android:id="@+id/rgNavigatorRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <RadioButton
                        android:id="@+id/rbGeneralUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="👤 General Citizen"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rbSeaCaptain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚓ Master Sea Captain (TSS &amp; Ports)"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rbAirlinePilot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✈️ International Airline Pilot (FL370)"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rbFleetDispatcher"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚛 Highway Fleet Logistics Dispatcher"
                        android:textSize="12sp" />
                </RadioGroup>
            </LinearLayout>

            <!-- Submit Button (Changes between "Sign In" and "Create Account") -->
            <com.google.android.material.button.MaterialButton
        android:insetTop="0dp"
        android:insetBottom="0dp"
                android:id="@+id/btnSubmitAuth"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/brand_ocean_primary"
                android:text="Sign In to AquaSky"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
