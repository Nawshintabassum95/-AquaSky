<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#081522"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AQUASKY"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Navigate Beyond Boundaries."
            android:textColor="#9CB3C8"
            android:textSize="14sp" />

        <!-- Online status -->
        <TextView
            android:id="@+id/txtConnection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#142B3B"
            android:padding="13dp"
            android:text="● DEMO MODE  |  Live data not connected"
            android:textColor="#FFC857"
            android:textSize="12sp" />

        <!-- Navigation mode -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="CHOOSE YOUR JOURNEY"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSea"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:backgroundTint="#087E8B"
                android:text="SEA"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnAir"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_marginHorizontal="5dp"
                android:layout_weight="1"
                android:backgroundTint="#174C77"
                android:text="AIR"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnLand"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:backgroundTint="#35465A"
                android:text="LAND"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- Route planning card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:background="#122637"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plan your route"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Choose an origin and destination to explore available routes."
                android:textColor="#A9BECE"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtOrigin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="17dp"
                android:backgroundTint="#3D7189"
                android:hint="Origin / departure"
                android:inputType="textCapWords"
                android:padding="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8DA5B7" />

            <EditText
                android:id="@+id/edtDestination"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#3D7189"
                android:hint="Destination / arrival"
                android:inputType="textCapWords"
                android:padding="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8DA5B7" />

            <Button
                android:id="@+id/btnPlanRoute"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="15dp"
                android:backgroundTint="#00A6A6"
                android:text="EXPLORE ROUTE"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Risk comparison -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:text="ROUTE INTELLIGENCE"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#122637"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fastest vs. Safer"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Compare estimated travel time, distance and available hazard information."
                android:textColor="#A9BECE"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Risk analysis will appear when route and hazard data are available."
                android:textColor="#FFC857"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Hazard alerts -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="HAZARD WATCH"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#122637"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weather &amp; Route Alerts"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtHazard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="No live hazard feed connected. This does not mean the route is safe."
                android:textColor="#FFC857"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Offline information -->
        <TextView
            android:id="@+id/txtOffline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#142B3B"
            android:padding="14dp"
            android:text="OFFLINE STATUS: Downloaded navigation data not configured yet."
            android:textColor="#A9BECE"
            android:textSize="12sp" />

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="AQUASKY  •  Navigate Beyond Boundaries"
            android:textColor="#71899D"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
