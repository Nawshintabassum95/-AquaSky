<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Soothing Sky Blue Light Theme -->
    <style name="Theme.AquaSky" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_ocean_primary</item>
        <item name="colorPrimaryVariant">@color/brand_ocean_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/brand_teal_marine</item>
        <item name="colorSecondaryVariant">@color/brand_sky_accent</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:statusBarColor">@color/brand_navy_header</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/bg_light</item>

        <item name="android:colorBackground">@color/bg_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>

        <item name="cardViewStyle">@style/AquaSky.CardView</item>
    </style>

    <style name="AquaSky.CardView" parent="CardView">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface_light</item>
        <item name="contentPadding">12dp</item>
    </style>
</resources>
