<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Soothing Midnight Navy Dark Theme -->
    <style name="Theme.AquaSky" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_sky_accent</item>
        <item name="colorPrimaryVariant">@color/brand_ocean_primary</item>
        <item name="colorOnPrimary">@color/bg_dark</item>

        <item name="colorSecondary">@color/brand_teal_marine</item>
        <item name="colorSecondaryVariant">@color/brand_sky_accent</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>

        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>

        <item name="cardViewStyle">@style/AquaSky.CardView.Dark</item>
    </style>

    <style name="AquaSky.CardView.Dark" parent="CardView">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">3dp</item>
        <item name="cardBackgroundColor">@color/surface_dark</item>
        <item name="contentPadding">12dp</item>
    </style>
</resources>
