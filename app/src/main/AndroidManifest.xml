<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions for Global Navigation, Weather API & Offline Sync -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:targetApi="tiramisu"/>

    <application
        android:name=".AquaSkyApplication"
        android:allowBackup="true"
        android:icon="@android:drawable/ic_dialog_map"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/ic_dialog_map"
        android:supportsRtl="true"
        android:theme="@style/Theme.AquaSky">

        <!-- 1. Main Worldwide Dashboard (First Page) -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Authentication Activity (Firebase Login & Register) -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- 3. Air Route Navigation (Aviation Corridors & RelativeLayout) -->
        <activity
            android:name=".activities.AirRouteActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- 4. Route Comparison (RecyclerView: Fastest vs Safest) -->
        <activity
            android:name=".activities.RouteComparisonActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- 5. Global Ports & Waypoints Directory (ListView Demo) -->
        <activity
            android:name=".activities.QuickPortsListActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Foreground Service for Worldwide Hazard & Weather Monitoring -->
        <service
            android:name=".components.HazardMonitoringService"
            android:enabled="true"
            android:exported="false" />


        <!-- Static Broadcast Receiver for Network, Battery & Airplane Mode Broadcasts -->
        <receiver
            android:name=".components.ConnectivityAndHazardReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.intent.action.BATTERY_OKAY" />
                <action android:name="android.intent.action.AIRPLANE_MODE" />
                <action android:name="com.aquasky.action.SEVERE_HAZARD_ALERT" />
            </intent-filter>
        </receiver>

        <!-- Content Provider: Shares Verified Road & Navigational Warnings -->
        <provider
            android:name=".components.AquaSkyHazardContentProvider"
            android:authorities="com.aquasky.provider"
            android:exported="true" />

    </application>

</manifest>
